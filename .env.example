# Copy to .env and fill in from your own Supabase project:
# Project Settings → Data API (URL) and API Keys (publishable key).
#
# Both values are safe in a browser bundle and are compiled into it. The
# publishable key grants only what row-level security allows, which is why the
# policies in supabase/migrations are the actual security boundary — read
# SETUP.md before changing them.
#
# Vite inlines these at BUILD time. After changing either one, rebuild:
#   local   → restart `npm run dev`
#   Docker  → `docker compose build`
#   Vercel  → redeploy (changing the variable alone does nothing)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
